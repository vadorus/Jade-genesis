# Jade Genesis - generated Android/Gradle files
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Python generated files
__pycache__/
*.pyc

# Repository hygiene
# Build/release archives belong in GitHub Actions artifacts or GitHub Releases,
# not beside the canonical source tree.
/Jade-genesis-main.zip
/jade-genesis-android-*.zip
/ci-logs/

# Jade Node for Windows build output / generated embedded payload
/windows-node/build/
/windows-node/**/bin/
/windows-node/**/obj/
/windows-node/JadeNode.Windows/Payload/*
!/windows-node/JadeNode.Windows/Payload/.gitkeep
